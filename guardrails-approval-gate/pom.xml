  <artifactId>guardrails-approval-gate</artifactId>
  <name>Guardrails Approval Gate</name>
  <description>Holds an escalated tool invocation until a human approves or rejects it.</description>

  <dependencies>
    <!-- Spec §7: EscalationResolver, EscalationOutcome, ToolInvocationContext and ChainVerdict -->
    <dependency>
      <groupId>io.github.tikyparkinson</groupId>
      <artifactId>guardrails-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spec §7: only @ConfigurationProperties in infrastructure -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
