<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.tikyparkinson</groupId>
    <artifactId>mcp-agent-guardrails-spring-boot-starter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>guardrails-audit</artifactId>
  <name>Guardrails Audit</name>
  <description>Audit trail of MCP tool invocations with a pluggable audit log store.</description>

  <dependencies>
    <!-- Spec §7: Guardrail SPI, ToolInvocationContext, Allow consumed by the adapter-in -->
    <dependency>
      <groupId>io.github.tikyparkinson</groupId>
      <artifactId>guardrails-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spec §7: only @ConfigurationProperties in infrastructure -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Spec §7: JdbcClient for the reference JDBC adapter; provided by the user's app -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spec §7: mandatory Testcontainers coverage for the real-store adapter -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spec §7: real JDBC driver for the Testcontainers integration test -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
